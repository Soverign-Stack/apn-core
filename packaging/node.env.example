# APN node settings. Installed as /etc/apn/node.env (root:apn, mode 0640).
# After changing this file:  sudo apn restart
#
# Lines are NAME=value, no spaces around "=", no quotes needed.

# Address of the relay. Use tls://host:port when the relay has TLS.
APN_RELAY_URL=nats://nonlocal.info:4222

# Relay login. Leave both commented out while the relay does not ask for one.
#APN_RELAY_USER=
#APN_RELAY_PASSWORD=

# Alternative to user/password: a NATS credentials file. The file must be
# readable by the apn user, for example /etc/apn/node.creds (root:apn, 0640).
#APN_RELAY_CREDS=/etc/apn/node.creds

# Only if the relay uses a private certificate authority (PEM file).
#APN_RELAY_CA=/etc/apn/relay-ca.pem

# Optional label shown in the Dashboard.
#APN_NODE_NAME=

# Privacy: by default the node does NOT send its hostname or hardware details.
# Set to 1 to send them.
#APN_SHARE_HARDWARE=0
